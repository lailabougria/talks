@model dynamic
@{
    ViewBag.Title = "Order placed";
}

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <div class="card my-4">
                <form action="/" method="POST">
                    <div class="card-body">
                        <h2 class="card-title">OrderId <code>@Model.OrderId</code> sent</h2>
                        <p>Your order has been placed successfully. You have sent <b>@Model.MessagesSent total messages</b>.</p>
                        <p>As a result of the button click:</p>
                        <ul>
                            <li>The <b>ClientUI</b> website sent a <code>PlaceOrder</code> command to the <b>Sales</b> service.</li>
                            <li>The <b>Sales</b> service will try to process <code>PlaceOrder</code>, but a simulated failure causes it to throw an exception.</li>
                            <li><b>Sales</b> will retry the message using delayed retries with a jittered back-off, before moving it to the <code>error</code> queue.</li>
                        </ul>
                        <p>Go look in the <b>Sales</b> console window to see the delayed retries being scheduled, each with a slightly different delay.</p>
                        <input type="submit" class="btn btn-lg btn-success" value="Place another order &raquo;" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
