@{
    ViewBag.Title = "Place an order";
}

<div class="container">
    <div class="row">
        <div class="col-lg-4">
            <div class="card my-4">
                <div class="card-body">
                    <form action="/" method="POST">
                        <h1 class="card-title">Place an order</h1>
                        <p class="card-text">Click the button to place an order.</p>
                        <input type="submit" class="btn btn-lg btn-success" value="Place order &raquo;" />
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card my-4">
                <div class="card-body">
                    <p>When you click the button:</p>
                    <ol>
                        <li>The <b>ClientUI</b> website will send a <code>PlaceOrder</code> command to the <b>Sales</b> service.</li>
                        <li>The <b>Sales</b> service will try to process <code>PlaceOrder</code>, but a simulated failure causes it to throw an exception.</li>
                        <li>Instead of failing immediately, <b>Sales</b> will retry the message using delayed retries with a jittered back-off.</li>
                        <li>When all retries are exhausted, the message is moved to the <code>error</code> queue, so it isn't lost.</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
</div>
